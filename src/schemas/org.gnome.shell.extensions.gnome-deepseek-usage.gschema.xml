<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
    <schema id="org.gnome.shell.extensions.gnome-deepseek-usage" path="/org/gnome/shell/extensions/gnome-deepseek-usage/">
        <key name="api-key" type="s">
            <default>''</default>
            <summary>DeepSeek API key</summary>
            <description>API key used to query the DeepSeek balance endpoint.</description>
        </key>
        <key name="refresh-interval" type="i">
            <default>300</default>
            <range min="60" max="3600"/>
            <summary>Refresh interval in seconds</summary>
            <description>How often the extension refreshes usage data from the DeepSeek API.</description>
        </key>
    </schema>
</schemalist>
